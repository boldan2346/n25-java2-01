package br.com.senaisp.bauru.secao04.aula09;

import java.util.Random;
import java.util.Scanner;

public class Forca {
	private String palavraSecreta;
	private String palavraMascarada;
	private int erros;
	//número aleatório
	private Random rnd;
	//Contructor
	public Forca() {
		rnd= new Random();
		int linhaEscolhida= rnd.nextInt(180);
		int linhaAtual= 0;
		Scanner sc= new Scanner(Forca.class.getResourceAsStream("palavras.txt"));
		while(sc.hasNextLine()) {
			String apoio= sc.nextLine();
			if(linhaAtual == linhaEscolhida) {
				palavraSecreta= "" + apoio;
				palavraMascarada = "_".repeat(palavraSecreta.length());
				break;
			}
			linhaAtual++;
		}
			sc.close();
			erros=0;
	}
	private String getPalavraMascarada() {
		return palavraMascarada;
	}
	private int getErros() {
		return erros;
	}
	@Override
	public String toString() {
		//123456
		String linha = " +---+\n"+//linha1
						" | " + (erros>=2 ? "\\": " ")+
						(erros>=1 ? "O" : " ")+
						(erros>=3 ? "/" : " ")+"\n" + //linha2
				" | " +	(erros>=4 ? "|" : " ")+"\n" + //linha3
				" | " + (erros>=5 ? "/": " ")+" " +
						(erros>=6 ? "\\": " ")+"\n" + //linha4
				" |\n" +                               //linha5
				"===" + getPalavraMascarada()+ "\n";  //linha6		
		return linha;
	}

	}
	
	

